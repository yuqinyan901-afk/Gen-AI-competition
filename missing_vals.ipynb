from dotenv import load_dotenv
import os
import pandas as pd
import numpy as np
import json

from langchain_openai import ChatOpenAI
from langchain_core.prompts import ChatPromptTemplate

load_dotenv()
API_KEY = os.getenv("OPENAI_API_KEY")

llm = ChatOpenAI(
    api_key=API_KEY,
    model="gpt-4o-mini",
    temperature=0
)

def drop_missing(df, threshold=0.3):
    missing_ratio = df.isnull().mean()
    cols_to_drop = missing_ratio[missing_ratio > threshold].index
    return df.drop(columns=cols_to_drop)


def fill_numeric(df, method="mean"):
    numeric_cols = df.select_dtypes(include=[np.number]).columns

    for col in numeric_cols:
        if method == "mean":
            df[col] = df[col].fillna(df[col].mean())
        elif method == "median":
            df[col] = df[col].fillna(df[col].median())
        elif method == "zero":
            df[col] = df[col].fillna(0)

    return df


def fill_categorical(df, method="mode"):
    cat_cols = df.select_dtypes(include=["object"]).columns

    for col in cat_cols:
        if method == "mode":
            df[col] = df[col].fillna(df[col].mode()[0])
        elif method == "unknown":
            df[col] = df[col].fillna("Unknown")

    return df

def get_llm_strategy(user_query, df_summary):
    """
    Ask LLM how to handle missing values
    """

    prompt = ChatPromptTemplate.from_messages([
        ("system",
         "You are a data cleaning expert. "
         "Choose best missing value strategy based on user request and dataset info. "
         "Return ONLY JSON."),
        ("user",
         """
User request: {query}

Dataset info:
{info}

Choose strategy from:
- drop
- mean
- median
- mode
- zero
- unknown

Return format:
{{
  "drop": true/false,
  "numeric": "mean|median|zero",
  "categorical": "mode|unknown"
}}
""")
    ])

    chain = prompt | llm

    result = chain.invoke({
        "query": user_query,
        "info": df_summary
    })

    try:
        return json.loads(result.content)
    except:
        return {
            "drop": False,
            "numeric": "mean",
            "categorical": "mode"
        }

def missing_vals(df, user_query):
    print(f"Missing values received: {user_query}")

    # dataset summary for LLM context
    df_summary = f"""
Rows: {df.shape[0]}
Columns: {df.shape[1]}
Missing per column:
{df.isnull().mean().to_string()}
"""

    # get strategy
    if API_KEY:
        strategy = get_llm_strategy(user_query, df_summary)
    else:
        # fallback rule-based
        strategy = {
            "drop": "drop" in user_query.lower(),
            "numeric": "mean",
            "categorical": "mode"
        }

    print("Strategy used:", strategy)

    # apply strategy
    if strategy.get("drop"):
        df = drop_missing(df)

    df = fill_numeric(df, strategy.get("numeric", "mean"))
    df = fill_categorical(df, strategy.get("categorical", "mode"))

    return df

dataset_name = "sample-data.csv"

PROJECT_ROOT = os.environ.get("PROJECT_ROOT", os.getcwd())
path = os.path.join(PROJECT_ROOT, "datasets", dataset_name)

df = pd.read_csv(path)
test_df = df.copy()

result_df = missing_vals(test_df, "handle missing values carefully, avoid losing data")
print(result_df.head())
